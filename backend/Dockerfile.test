# Test Dockerfile - Complete test environment for KubeEye backend with uv
FROM python:3.14-alpine

# Set environment variables
ENV PYTHONPATH=/app
ENV KUBEEYE_DATA_DIR=/app/data
ENV UV_CACHE_DIR=/tmp/uv-cache
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies
RUN apk update && \
    apk add --no-cache \
    gcc \
    musl-dev \
    libffi-dev \
    openssl-dev \
    openssh-client \
    curl \
    libgit2-dev \
    font-dejavu \
    font-liberation \
    tzdata && \
    apk del --no-cache apk-tools

# Download OPA and Popeye binaries for the correct architecture
RUN set -eux; \
    ARCH=$(uname -m); \
    case "${ARCH}" in \
        x86_64) RELEASE_ARCH="amd64" ;; \
        aarch64) RELEASE_ARCH="arm64" ;; \
        arm*) RELEASE_ARCH="arm" ;; \
        *) echo "Unsupported architecture: ${ARCH}"; exit 1 ;; \
    esac; \
    OPA_VERSION="v1.12.2"; \
    curl -sSL "https://github.com/open-policy-agent/opa/releases/download/${OPA_VERSION}/opa_linux_${RELEASE_ARCH}_static" -o opa && \
    chmod +x opa && \
    mv opa /usr/local/bin/opa; \
    POPEYE_VERSION="v0.22.1"; \
    curl -L "https://github.com/derailed/popeye/releases/download/${POPEYE_VERSION}/popeye_linux_${RELEASE_ARCH}.tar.gz" -o popeye.tar.gz && \
    tar -xzf popeye.tar.gz && \
    chmod +x popeye && \
    mv popeye /usr/local/bin/popeye && \
    rm popeye.tar.gz

# Set working directory
WORKDIR /app

# First copy requirements.txt to utilize Docker cache
COPY requirements.txt /app/

# Install uv
RUN pip install --no-cache-dir uv

# Install Python dependencies with uv
RUN uv pip install --system --no-cache-dir -r requirements.txt

# Install additional test dependencies with uv
RUN uv pip install --system --no-cache-dir \
    pytest>=9.0.2 \
    pytest-cov>=7.0.0 \
    pytest-mock>=3.15.1 \
    pytest-timeout>=2.4.0 \
    pytest-asyncio>=1.3.0 \
    black>=25.12.0 \
    flake8>=7.3.0 \
    pylint>=4.0.4

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/ || exit 1

# Default command for testing
CMD ["pytest", "/app/tests/", "-v", "--tb=short", "--cov=app", "--cov-report=term-missing"]